{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.json",
  "_comment": "MCP servers template for deadlion-studio. Generated by install-ai-team.sh",
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "context7-mcp-server"
      ],
      "env": {
        "CONTEXT7_API_KEY": ""
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "cclsp": {
      "command": "npx",
      "args": [
        "-y",
        "cclsp"
      ],
      "env": {
        "CCLSP_CONFIG_PATH": "./config/cclsp.json"
      }
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ]
    },
    "mobile-mcp": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "tools": [
        "*"
      ]
    }
  }
}